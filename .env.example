# Copy this file to .env and adjust values before running docker compose up.

# Port exposed on the host machine (the container always listens on 3000 internally).
HOST_PORT=8080

# Secret used to sign JWT auth tokens. MUST be changed to a long random value for real use.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Set to "true" to disable the signup/account-creation page and endpoint,
# once you (and anyone else who needs an account) have registered.
DISABLE_SIGNUP=false
